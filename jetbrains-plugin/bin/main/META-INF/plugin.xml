<idea-plugin url="https://github.com/vaquarkhan/data-engineering-agent-skills/tree/main/jetbrains-plugin">
    <id>com.vaquarkhan.dataengineeringskills</id>
    <name>Data Engineering Agent Skills</name>
    <vendor email="vaquarkhan@users.noreply.github.com" url="https://github.com/vaquarkhan/data-engineering-agent-skills">vaquarkhan</vendor>
    <description><![CDATA[
      Installs data engineering skill packs, agent adapters, starter packs, MCP templates, and runnable examples into JetBrains IDE workspaces.
    ]]></description>
    <change-notes><![CDATA[
      Initial JetBrains plugin scaffold with installer actions for the core toolkit, starter packs, MCP templates, and runnable examples.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
    </extensions>

    <actions>
        <group id="DataEngineeringAgentSkills.Group"
               text="Data Engineering Agent Skills"
               description="Install data engineering skill packs into the current project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="DataEngineeringAgentSkills.InstallFullToolkit"
                    class="com.vaquarkhan.dataengineeringskills.InstallFullToolkitAction"
                    text="Install Full Toolkit"
                    description="Install the full data engineering toolkit into the current project"/>

            <action id="DataEngineeringAgentSkills.InstallCorePack"
                    class="com.vaquarkhan.dataengineeringskills.InstallCorePackAction"
                    text="Install Core Pack"
                    description="Install the core files into the current project"/>

            <action id="DataEngineeringAgentSkills.InstallAgentAdapters"
                    class="com.vaquarkhan.dataengineeringskills.InstallAgentAdaptersAction"
                    text="Install Agent Adapters"
                    description="Install agent adapter files into the current project"/>

            <action id="DataEngineeringAgentSkills.InstallStarterPack"
                    class="com.vaquarkhan.dataengineeringskills.InstallStarterPackAction"
                    text="Install Starter Pack"
                    description="Install a starter pack into the current project"/>

            <action id="DataEngineeringAgentSkills.InstallMcpTemplates"
                    class="com.vaquarkhan.dataengineeringskills.InstallMcpTemplatesAction"
                    text="Install MCP Templates"
                    description="Install MCP templates into the current project"/>

            <action id="DataEngineeringAgentSkills.ScaffoldRunnableExample"
                    class="com.vaquarkhan.dataengineeringskills.ScaffoldRunnableExampleAction"
                    text="Scaffold Runnable Example"
                    description="Scaffold a runnable example into the current project"/>
        </group>
    </actions>
</idea-plugin>
