{
  "name": "kafka",
  "description": "Topic, consumer-group, and message metadata access for streaming validation, lag review, and replay analysis.",
  "transport": {
    "type": "stdio",
    "command": "kafka-mcp-server",
    "args": [
      "--read-only",
      "--topic-allowlist",
      "${KAFKA_TOPIC_ALLOWLIST}"
    ],
    "env": {
      "KAFKA_BOOTSTRAP_SERVERS": "${KAFKA_BOOTSTRAP_SERVERS}",
      "KAFKA_SECURITY_PROTOCOL": "${KAFKA_SECURITY_PROTOCOL}",
      "KAFKA_SASL_MECHANISM": "${KAFKA_SASL_MECHANISM}",
      "KAFKA_SASL_USERNAME": "${KAFKA_SASL_USERNAME}",
      "KAFKA_SASL_PASSWORD": "${KAFKA_SASL_PASSWORD}",
      "KAFKA_TOPIC_ALLOWLIST": "${KAFKA_TOPIC_ALLOWLIST}"
    }
  },
  "metadata": {
    "validation": [
      "kcat -L -b \"$KAFKA_BOOTSTRAP_SERVERS\""
    ],
    "best_for": [
      "topic inspection",
      "consumer lag review",
      "replay analysis"
    ]
  }
}
